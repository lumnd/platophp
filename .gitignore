docs/node_modules/
docs/package-lock.json

# Runtime output. Keep these patterns anchored at the repository root so they do not hide
# framework source directories such as src/cache/. Tests write to isolated system temp paths.
/data/
/cache/
/compile/
/log/
/temp/
*.log
*.pid

